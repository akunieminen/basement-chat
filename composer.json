{
  "name": "basement-chat/basement-chat",
  "type": "library",
  "description": "Add a real-time chat widget to your Laravel application.",
  "keywords": [
    "laravel",
    "php",
    "websocket",
    "chat",
    "realtime",
    "basement"
  ],
  "homepage": "https://github.com/basement-chat/basement-chat",
  "license": "MIT",
  "authors": [
    {
      "name": "Yusuf T.",
      "email": "dev.yusuftaufiq@gmail.com"
    }
  ],
  "require": {
    "php": "^8.3",
    "laravel/framework": "^12.0 || ^13.0",
    "laravel/sanctum": "^4.0",
    "spatie/laravel-package-tools": "^1.93.2"
  },
  "require-dev": {
    "larastan/larastan": "^3.12",
    "laravel/pint": "^1.32",
    "laravel/reverb": "^1.11",
    "nunomaduro/phpinsights": "^2.14.2",
    "orchestra/testbench": "^10.11 || ^11.2",
    "orchestra/testbench-dusk": "^10.11 || ^11.4",
    "phpstan/phpstan-deprecation-rules": "^2.0.5",
    "phpstan/phpstan-phpunit": "^2.0.18",
    "phpunit/phpunit": "^11.5.50 || ^12.5.8 || ^13.0",
    "pusher/pusher-php-server": "^7.3"
  },
  "autoload": {
    "psr-4": {
      "BasementChat\\Basement\\": "src",
      "BasementChat\\Basement\\Database\\Factories\\": "database/factories"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "BasementChat\\Basement\\Tests\\": "tests"
    }
  },
  "scripts": {
    "analyse": "vendor/bin/phpstan analyse --memory-limit=256M",
    "format": "vendor/bin/pint",
    "insights": "vendor/bin/phpinsights analyse config database routes src",
    "test": [
      "Composer\\Config::disableProcessTimeout",
      "vendor/bin/testbench package:test"
    ],
    "test:unit": [
      "Composer\\Config::disableProcessTimeout",
      "vendor/bin/testbench package:test --testsuite=Unit"
    ],
    "test:feature": [
      "Composer\\Config::disableProcessTimeout",
      "vendor/bin/testbench package:test --testsuite=Feature"
    ],
    "test:browser": [
      "Composer\\Config::disableProcessTimeout",
      "vendor/bin/testbench package:test --testsuite=Browser"
    ],
    "post-autoload-dump": "@php vendor/bin/testbench package:discover --ansi"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "BasementChat\\Basement\\BasementServiceProvider"
      ],
      "aliases": {
        "Basement": "BasementChat\\Basement\\Facades\\Basement"
      }
    }
  },
  "prefer-stable": true
}
