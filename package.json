{
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rm -rf ./dist",
    "commit": "cz",
    "build": "npm run clean && rollup -c",
    "dev": "vite",
    "format": "prettier --write \".devcontainer\" \".github/**/*.yml\" \"resources/css/**/*.css\" \"resources/js/**/*.ts\" \"resources/views/**/*.blade.php\" \"*.js\" \"*.cjs\" \"*.json\" \"*.yaml\" \"*.md\"",
    "format:blade": "prettier --write \"resources/views/**/*.blade.php\"",
    "lint": "eslint \"./resources/js/**/*.ts\" --fix",
    "lint:ci": "eslint \"./resources/js/**/*.ts\""
  },
  "dependencies": {
    "@alpinejs/intersect": "^3.17.3",
    "alpinejs": "^3.17.3",
    "axios": "^1.20.0",
    "laravel-echo": "^2.5.0",
    "pusher-js": "^8.6.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@shufo/prettier-plugin-blade": "^1.16.2",
    "@soketi/soketi": "^1.6.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/alpinejs": "^3.13.11",
    "@types/mark.js": "^8.11.12",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "date-fns": "^4.4.0",
    "eslint": "^10.10.0",
    "laravel-vite-plugin": "^3.2.0",
    "mark.js": "^8.11.1",
    "postcss-prefix-selector": "^2.2.1",
    "prettier": "^3.9.7",
    "push.js": "^1.0.12",
    "rollup": "^4.63.3",
    "rollup-plugin-filesize": "^10.0.0",
    "rollup-plugin-postcss": "^4.0.2",
    "semantic-release": "^25.0.9",
    "tailwindcss": "^4.3.3",
    "tippy.js": "^6.3.7",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "wait-on": "^9.1.0"
  },
  "overrides": {
    "uWebSockets.js": "github:uNetworking/uWebSockets.js#v20.71.0"
  }
}
