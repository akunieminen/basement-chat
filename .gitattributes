# Path-based git attributes
# https://www.kernel.org/pub/software/scm/git/docs/gitattributes.html

# Ignore all test and documentation with "export-ignore".
# dist/ and resources/views MUST stay exported: consumers load the compiled assets and Blade views from vendor/.
/.github            export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/.devcontainer      export-ignore
/.editorconfig      export-ignore
/.prettierrc.json   export-ignore
/.prettierignore    export-ignore
/.releaserc.json    export-ignore
/tests              export-ignore
/resources/js       export-ignore
/phpunit.xml.dist   export-ignore
/phpstan.neon.dist  export-ignore
/phpstan-baseline.neon  export-ignore
/phpstan-class-aliases.php  export-ignore
/phpinsights.php    export-ignore
/pint.json          export-ignore
/package.json       export-ignore
/package-lock.json  export-ignore
/rollup.config.js   export-ignore
/vite.config.js     export-ignore
/eslint.config.js   export-ignore
/postcss.config.cjs export-ignore
/tsconfig.json      export-ignore
/CONTRIBUTING.md    export-ignore
/UPGRADING.md       export-ignore
